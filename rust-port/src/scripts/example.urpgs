// Untitled RPG Script example (C-style braces and strings)

dialogue("Welcome, traveler. This is a .urpgs script.");
give("apple", 3);
gold(25);
dialogue("You got 3 apples and 25 gold.");

flag("met_wizard");
if (flag met_wizard) {
  dialogue("The wizard remembers you.");
} else {
  dialogue("You have never met the wizard.");
}

if (player.item apple 3) {
  gold(10);
  dialogue("Your apples earned you 10 more gold.");
}

if (player.health < 50) {
  heal(20);
  dialogue("You were hurt. Here, have some health.");
}

if (player.facing right) {
  dialogue("You are facing right.");
} else if (map map1) {
  dialogue("You are still in the first map.");
}

spawn("bat", 12, 10);
wait(0.5);
dialogue("A bat appeared! Good luck.");
end();
